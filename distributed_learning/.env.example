# =============================================================================
# Copy this file to .env and edit the values for your setup:
#   cp .env.example .env
# =============================================================================

# ─── REQUIRED ─────────────────────────────────────────────────────────────────
VOLUNTEER_ID=0                      # unique 0-indexed ID for this volunteer
COORDINATOR_HOST=192.168.1.106       # IP/hostname of the coordinator
MANAGER_HOST=192.168.1.106         # IP/hostname of the manager

# ─── OPTIONAL — defaults match src/config.py ─────────────────────────────────
# N_VOLUNTEERS=5
# MY_IP=192.168.1.106                          # auto-detected if left empty
# DATASET=mnist                     # mnist | cifar10
# DATA_PARTITION=iid            # iid | non-iid
# COMPRESSION=quantization          # quantization | sparsification | none
# K_NEIGHBORS=3
# GOSSIP_INTERVAL=60                # seconds between rounds (keep it small, 60s is a good default)
# GOSSIP_FANOUT=1
# LOCAL_EPOCHS=3
# MAX_ROUNDS=15                    # 0 = without limit
# BATCH_SIZE=32
# LEARNING_RATE=0.01
# NUM_CLASSES=10
# LOG_LEVEL=INFO
# HEARTBEAT_INTERVAL=10
# HEARTBEAT_TIMEOUT=35
# SOCKET_TIMEOUT=60

# ─── OPTIONAL — hardware hints (advertised to coordinator) ───────────────────
# CPU_CORES=4
# RAM_GB=8
# NETWORK_MBPS=100

# ─── AD-PSGD — Lian et al. (2018) arxiv:1710.06952 ──────────────────────
# ADPSGD_ENABLED=true          # true | false
# ADPSGD_TOPOLOGY=exponential  # exponential (O(log n)) | ring (O(n))
# ADPSGD_ROLE=auto             # auto | active | passive
# ADPSGD_ALPHA=0.5             # poids de la moyenne symétrique (0 < alpha < 1)
