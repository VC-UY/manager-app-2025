# Configuration de l'application Manager
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# Sécurité Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend Manager)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Adresse du serveur Coordinator
COORDINATOR_HOST=localhost
COORDINATOR_PROXY_PORT=6380

# Pour une utilisation en production avec un Coordinator déployé sur VPS:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<générer-une-clé-forte>
# COORDINATOR_HOST=173.249.38.251
# COORDINATOR_PROXY_PORT=6380
